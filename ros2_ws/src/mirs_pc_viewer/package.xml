<?xml version="1.0"?>
<package format="3">
  <name>mirs_pc_viewer</name>
  <version>0.1.0</version>
  <description>Preview cleaning zones from the MIRS BLE app in RViz using OpenNav Coverage.</description>
  <maintainer email="maintainer@example.com">MIRS</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>opennav_coverage_msgs</exec_depend>
  <exec_depend>opennav_coverage</exec_depend>
